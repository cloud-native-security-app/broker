{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-app.example.test/broker/contracts/security-event.schema.json",
  "title": "SecurityEvent",
  "description": "Immutable domain fact published to the Kinesis Data Stream security-events by gateway, nmap-service, user-service and, for siem.alert, the gateway relaying a Wazuh alert (source wazuh), and read by the gateway admin panel. Partition key (documented, not enforced here): scan_id, else actor_sub, else agent.id for siem.alert. Events never carry credentials, tokens, raw scan output or message bodies: every object is closed (additionalProperties false) and reasons are short codes, never free text. No schema_version on purpose (docs/architecture.md).",
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false,
      "description": "No payload fields: the envelope carries everything."
    },
    "scanRequestedPayload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
            },
            {
              "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
            }
          ],
          "description": "IPv4 or IPv6 target, same patterns as scan-request.schema.json#/properties/ip."
        },
        "target_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
          "description": "Hostname as typed by the user, same pattern as scan-request.schema.json#/properties/target_host. Optional and network mode only; `target` stays the pinned IP that was scanned."
        },
        "scan_mode": {
          "type": "string",
          "enum": [
            "ssh",
            "network"
          ],
          "default": "ssh",
          "description": "Scan mode of the request, same enum as scan-request.schema.json#/properties/scan_mode. Optional; absence means ssh, so events from producers that predate the field stay valid."
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "scanCancelledPayload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
            },
            {
              "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
            }
          ],
          "description": "IPv4 or IPv6 target, same patterns as scan-request.schema.json#/properties/ip."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scanCompletedPayload": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "finding_counts": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "duration_ms",
        "finding_counts"
      ],
      "additionalProperties": false
    },
    "scanFailedPayload": {
      "type": "object",
      "properties": {
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Short machine code (e.g. ssh_timeout). Never free text or tool output."
        }
      },
      "required": [
        "reason_code"
      ],
      "additionalProperties": false
    },
    "findingCriticalPayload": {
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535,
          "description": "Port of the finding, or null for a host-level finding."
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp",
            null
          ],
          "description": "Protocol of the port, or null for a host-level finding."
        },
        "cve_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$",
          "description": "CVE identifier, or null when the finding has none."
        },
        "severity": {
          "enum": [
            "high",
            "critical"
          ]
        },
        "confidence": {
          "enum": [
            "confirmed",
            "version_match"
          ]
        }
      },
      "required": [
        "port",
        "protocol",
        "cve_id",
        "severity",
        "confidence"
      ],
      "additionalProperties": false
    },
    "ratelimitHitPayload": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/[^?#\\s]{0,199}$",
          "description": "Route path or template; no query string or fragment."
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "route",
        "limit",
        "window_seconds"
      ],
      "additionalProperties": false
    },
    "messageDeadletteredPayload": {
      "type": "object",
      "properties": {
        "queue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "queue",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "auditRecordedPayload": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "resource_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        }
      },
      "required": [
        "action",
        "resource_type"
      ],
      "additionalProperties": false
    },
    "ipAddress": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
        },
        {
          "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
        }
      ],
      "description": "IPv4 or IPv6 address, same patterns as scanRequestedPayload target."
    },
    "siemAlertPayload": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "Wazuh rule.id (numeric string in practice)."
        },
        "rule_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "Wazuh rule.level, 0..15."
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Derived from rule_level by the producer: 0-6 low, 7-9 medium, 10-12 high, 13-15 critical (D-18). The schema enforces the mapping."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Wazuh rule.description (rule text, never the raw log line)."
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$",
              "description": "Wazuh agent.id, e.g. 000 for the manager."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "src_ip": {
          "$ref": "#/$defs/ipAddress"
        },
        "dest_ip": {
          "$ref": "#/$defs/ipAddress"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Suricata data.alert.signature, present only for Suricata alerts relayed by Wazuh."
        }
      },
      "required": [
        "rule_id",
        "rule_level",
        "severity",
        "description",
        "agent"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_level": {
                "minimum": 0,
                "maximum": 6
              }
            },
            "required": [
              "rule_level"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "low"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule_level": {
                "minimum": 7,
                "maximum": 9
              }
            },
            "required": [
              "rule_level"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "medium"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule_level": {
                "minimum": 10,
                "maximum": 12
              }
            },
            "required": [
              "rule_level"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "high"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule_level": {
                "minimum": 13,
                "maximum": 15
              }
            },
            "required": [
              "rule_level"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "critical"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "UUID, unique per event; consumers dedupe on it (Kinesis is at-least-once)."
    },
    "event_type": {
      "enum": [
        "scan.requested",
        "scan.cancelled",
        "scan.started",
        "scan.completed",
        "scan.failed",
        "finding.critical",
        "auth.login",
        "auth.logout",
        "ratelimit.hit",
        "message.deadlettered",
        "audit.recorded",
        "siem.alert"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 with offset. The pattern is there because format is only an annotation in draft 2020-12."
    },
    "source": {
      "enum": [
        "gateway",
        "nmap-service",
        "user-service",
        "wazuh"
      ]
    },
    "actor_sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "JWT sub of the user who caused the event."
    },
    "scan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Scan identifier, same free-string shape as correlation_id in the scan contracts."
    },
    "payload": {
      "type": "object",
      "description": "Shape depends on event_type (see allOf)."
    }
  },
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "scan.requested"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scanRequestedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "scan.cancelled"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scanCancelledPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "scan.started"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "scan.completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scanCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "scan.failed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scanFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "finding.critical"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/findingCriticalPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "auth.login"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "auth.logout"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ratelimit.hit"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ratelimitHitPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "message.deadlettered"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/messageDeadletteredPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "audit.recorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/auditRecordedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "siem.alert"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/siemAlertPayload"
          },
          "source": {
            "const": "wazuh"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "scan_id"
              ]
            },
            {
              "required": [
                "actor_sub"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "scan.requested",
              "scan.cancelled",
              "scan.started",
              "scan.completed",
              "scan.failed",
              "finding.critical"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "scan_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "auth.login",
              "auth.logout",
              "ratelimit.hit",
              "audit.recorded"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "actor_sub"
        ]
      }
    }
  ]
}
